<?xml version="1.0" encoding="UTF-8"?>
<!--
  Entitlements of the BigBlueButton Broadcast Upload Extension.
  Template: tools/ios/add-broadcast-extension.mjs fills the app-group placeholder in and writes
  the result to <ios dir>/<target>/<target>.entitlements (see docs/ios-screen-share.md).

  The tool gives the app target the same group in its own entitlements. Both App IDs
  must have the App Groups capability enabled in the Apple Developer portal, and automatic signing
  adds the group to both provisioning profiles.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>{{APP_GROUP}}</string>
	</array>
</dict>
</plist>
